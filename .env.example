# Copy to .env and set the exact URL used in your browser (scheme + host + port).
# For NAS LAN access, example: http://192.168.1.20:8080
# For an HTTPS reverse proxy, example: https://circuits.example.com
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0

# Optional, only when compose.fnos.yaml is used. Create this folder first and
# grant UID/GID 1000 read/write access. Use a real absolute NAS path.
# SILICON_HOST_DATA_DIR=/absolute/path/to/silicon-infinity-data
